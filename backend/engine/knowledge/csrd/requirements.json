[
  {
    "id": "CSRD-S-001",
    "version": 3,
    "ruleRef": "R-001",
    "title": "Individual Article 19a threshold scope",
    "program": "CSRD",
    "decisionArea": "Individual scope",
    "plainEnglish": "An undertaking falls within Article 19a where it exceeds EUR 450 million net turnover and an average of 1,000 employees during the financial year. Both thresholds are cumulative.",
    "scopeType": "legal_entity",
    "relationshipClass": "direct_legal",
    "severity": "critical",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "in_catalogue",
          "fact": "entity.incorporation_country",
          "catalogue": "eu_member_states"
        },
        {
          "op": "in_catalogue",
          "fact": "entity.legal_form",
          "catalogue": "accounting_directive_forms"
        },
        {
          "op": "cmp",
          "fact": "entity.net_turnover_eur",
          "cmp": "gt",
          "value": 450000000
        },
        {
          "op": "cmp",
          "fact": "entity.avg_employees",
          "cmp": "gt",
          "value": 1000
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 19a(1)"
          }
        ]
      }
    ],
    "caution": "Threshold-crossing ranges are indeterminate — ask for the exact value. This is scope, not the final reporting duty (see CSRD-S-014); national transposition may vary timing and options."
  },
  {
    "id": "CSRD-S-002",
    "version": 4,
    "ruleRef": "R-002",
    "title": "Consolidated Article 29a threshold scope",
    "program": "CSRD",
    "decisionArea": "Consolidated scope",
    "plainEnglish": "A parent undertaking falls within Article 29a where its group exceeds EUR 450 million net turnover and an average of 1,000 employees on a consolidated basis. This is the consolidated size test only; it does not decide whether or when the group must report. CSRD-S-014 composes the threshold and exemption results into the reporting duty, and the financial-year questions rest with CSRD-S-003, CSRD-S-004 (Article 5(2) of Directive (EU) 2022/2464) and the national overlay (CSRD-S-013).",
    "scopeType": "legal_entity",
    "relationshipClass": "direct_legal",
    "severity": "critical",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "in_catalogue",
          "fact": "entity.incorporation_country",
          "catalogue": "eu_member_states"
        },
        {
          "op": "in_catalogue",
          "fact": "entity.legal_form",
          "catalogue": "accounting_directive_forms"
        },
        {
          "op": "eq",
          "fact": "entity.is_parent_undertaking",
          "value": true
        },
        {
          "op": "cmp",
          "fact": "group.consolidated_net_turnover_eur",
          "cmp": "gt",
          "value": 450000000
        },
        {
          "op": "cmp",
          "fact": "group.avg_employees",
          "cmp": "gt",
          "value": 1000
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 29a(1)"
          }
        ]
      }
    ],
    "caution": "Use the legal consolidation perimeter, not internal business units."
  },
  {
    "id": "CSRD-S-003",
    "version": 3,
    "ruleRef": "R-004",
    "title": "First-wave (FY2024) reporting history",
    "program": "CSRD",
    "decisionArea": "Wave history",
    "plainEnglish": "Prior FY2024 CSRD reporters are a distinct population; their FY2025–26 position depends on the amended thresholds and the governing Member State's transitional implementation.",
    "scopeType": "legal_entity",
    "relationshipClass": "timing_context",
    "severity": "medium",
    "kind": "boolean",
    "condition": {
      "op": "eq",
      "fact": "entity.reported_csrd_fy2024",
      "value": true
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-002",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 5(2)"
          }
        ]
      }
    ],
    "caution": "Never tell a former reporter to stop based only on an EU-level threshold screen (see CSRD-S-004 and CSRD-S-013)."
  },
  {
    "id": "CSRD-S-004",
    "version": 3,
    "ruleRef": "R-006",
    "title": "FY2025–26 national transition exemption",
    "program": "CSRD",
    "decisionArea": "Transition exemption",
    "plainEnglish": "Member States may relieve undertakings that fall below either amended threshold for financial years beginning between 1 January 2025 and 31 December 2026, where the national transition option is exercised.",
    "scopeType": "legal_entity",
    "relationshipClass": "direct_legal_exemption",
    "severity": "high",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "in_catalogue",
          "fact": "entity.incorporation_country",
          "catalogue": "eu_member_states"
        },
        {
          "op": "fy_start_year_in",
          "years": [
            2025,
            2026
          ]
        },
        {
          "op": "any",
          "of": [
            {
              "op": "not",
              "of": {
                "op": "cmp",
                "fact": "entity.net_turnover_eur",
                "cmp": "gt",
                "value": 450000000
              }
            },
            {
              "op": "not",
              "of": {
                "op": "cmp",
                "fact": "entity.avg_employees",
                "cmp": "gt",
                "value": 1000
              }
            }
          ]
        },
        {
          "op": "eq",
          "fact": "entity.member_state_transition_option",
          "value": true
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-002",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 5(2), fifth subparagraph"
          }
        ]
      }
    ],
    "caution": "Requires the governing country pack — this is a national option, not a universal automatic exemption."
  },
  {
    "id": "CSRD-S-005",
    "version": 3,
    "ruleRef": "R-007",
    "title": "Subsidiary exemption via qualifying EU-parent consolidated report",
    "program": "CSRD",
    "decisionArea": "Exemption",
    "plainEnglish": "A subsidiary may be exempt from individual sustainability reporting where it is included in a qualifying EU parent consolidated sustainability report and the publication, identification and related conditions are met.",
    "scopeType": "legal_entity",
    "relationshipClass": "direct_legal_exemption",
    "severity": "high",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "eq",
          "fact": "entity.is_subsidiary",
          "value": true
        },
        {
          "op": "in_catalogue",
          "fact": "group.ultimate_parent_country",
          "catalogue": "eu_member_states"
        },
        {
          "op": "eq",
          "fact": "parent.report_includes_entity",
          "value": true
        },
        {
          "op": "eq",
          "fact": "parent.report_standard",
          "value": "ESRS"
        },
        {
          "op": "exists",
          "fact": "parent.report_public_url"
        },
        {
          "op": "eq",
          "fact": "entity.national_publication_conditions_met",
          "value": true
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 19a(9)"
          }
        ]
      }
    ],
    "caution": "Scope and exemption are separate determinations: 'threshold in scope but exempt' must never be summarised as 'CSRD does not apply'. Exemption evidence must remain current every year (O-011)."
  },
  {
    "id": "CSRD-S-006",
    "version": 3,
    "ruleRef": "R-007",
    "title": "Subsidiary exemption via qualifying non-EU parent report",
    "program": "CSRD",
    "decisionArea": "Exemption",
    "plainEnglish": "A subsidiary of a non-EU parent may be exempt where it is included in a qualifying parent report prepared under ESRS or standards deemed equivalent, with assurance, required EU Taxonomy information and publication conditions met.",
    "scopeType": "legal_entity",
    "relationshipClass": "direct_legal_exemption",
    "severity": "high",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "eq",
          "fact": "entity.is_subsidiary",
          "value": true
        },
        {
          "op": "not",
          "of": {
            "op": "in_catalogue",
            "fact": "group.ultimate_parent_country",
            "catalogue": "eu_member_states"
          }
        },
        {
          "op": "eq",
          "fact": "parent.report_includes_entity",
          "value": true
        },
        {
          "op": "in_set",
          "fact": "parent.report_standard",
          "set": [
            "ESRS",
            "EQUIVALENT"
          ]
        },
        {
          "op": "eq",
          "fact": "parent.assurance_opinion_available",
          "value": true
        },
        {
          "op": "eq",
          "fact": "parent.taxonomy_information_included",
          "value": true
        },
        {
          "op": "eq",
          "fact": "entity.national_publication_conditions_met",
          "value": true
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 19a(9)"
          }
        ]
      }
    ],
    "caution": "'EQUIVALENT' requires a formal equivalence basis — treat as legal judgment with a signed DecisionRecord until an equivalence decision exists."
  },
  {
    "id": "CSRD-S-007",
    "version": 3,
    "ruleRef": "R-009",
    "title": "Article 40a third-country group gate",
    "program": "CSRD",
    "decisionArea": "Third-country scope",
    "plainEnglish": "A non-EU ultimate parent enters the Article 40a route where it generated more than EUR 450 million net turnover in the EU in each of the last two consecutive financial years. The two years are tested separately, never averaged.",
    "scopeType": "organization",
    "relationshipClass": "direct_legal",
    "severity": "high",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "not",
          "of": {
            "op": "in_catalogue",
            "fact": "group.ultimate_parent_country",
            "catalogue": "eu_member_states"
          }
        },
        {
          "op": "cmp",
          "fact": "third_country.eu_turnover_year_1_eur",
          "cmp": "gt",
          "value": 450000000
        },
        {
          "op": "cmp",
          "fact": "third_country.eu_turnover_year_2_eur",
          "cmp": "gt",
          "value": 450000000
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 40a"
          }
        ]
      }
    ]
  },
  {
    "id": "CSRD-S-008",
    "version": 3,
    "ruleRef": "R-010",
    "title": "Article 40a subsidiary gateway",
    "program": "CSRD",
    "decisionArea": "Third-country scope",
    "plainEnglish": "The Article 40a route applies through an EU subsidiary where the group gate is met and that subsidiary exceeded EUR 200 million net turnover in the preceding financial year.",
    "scopeType": "legal_entity",
    "relationshipClass": "direct_legal",
    "severity": "high",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "requirement_ref",
          "requirement": "CSRD-S-007",
          "expect": "APPLIES"
        },
        {
          "op": "in_catalogue",
          "fact": "entity.incorporation_country",
          "catalogue": "eu_member_states"
        },
        {
          "op": "eq",
          "fact": "entity.is_subsidiary",
          "value": true
        },
        {
          "op": "cmp",
          "fact": "third_country.eu_subsidiary_turnover_eur",
          "cmp": "gt",
          "value": 200000000
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 40a"
          }
        ]
      }
    ],
    "caution": "The subsidiary is a publication gateway, not necessarily the reporting parent. Art. 40a reporting runs for financial years beginning on or after 1 January 2028 (R-012)."
  },
  {
    "id": "CSRD-S-009",
    "version": 3,
    "ruleRef": "R-011",
    "title": "Article 40a branch gateway",
    "program": "CSRD",
    "decisionArea": "Third-country scope",
    "plainEnglish": "A branch is the gateway where the group gate is met, no qualifying EU subsidiary exists, and the branch exceeded EUR 200 million net turnover in the preceding financial year.",
    "scopeType": "branch",
    "relationshipClass": "direct_legal",
    "severity": "high",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "requirement_ref",
          "requirement": "CSRD-S-007",
          "expect": "APPLIES"
        },
        {
          "op": "eq",
          "fact": "third_country.qualifying_eu_subsidiary_exists",
          "value": false
        },
        {
          "op": "cmp",
          "fact": "third_country.eu_branch_turnover_eur",
          "cmp": "gt",
          "value": 200000000
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 40a"
          }
        ]
      }
    ],
    "caution": "Evaluate the branch gateway only after the subsidiary gateway."
  },
  {
    "id": "CSRD-S-010",
    "version": 3,
    "ruleRef": "R-013",
    "title": "Protected value-chain undertaking",
    "program": "CSRD",
    "decisionArea": "Value chain",
    "plainEnglish": "A value-chain undertaking with no more than 1,000 average employees in the preceding financial year receives statutory protection from above-cap CSRD information requests made by a CSRD reporter for its CSRD reporting.",
    "scopeType": "request",
    "relationshipClass": "indirect_operational",
    "severity": "high",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "eq",
          "fact": "value_chain.requestor_is_csrd_reporter",
          "value": true
        },
        {
          "op": "eq",
          "fact": "value_chain.request_purpose",
          "value": "CSRD_REPORTING"
        },
        {
          "op": "cmp",
          "fact": "value_chain.respondent_avg_employees",
          "cmp": "lte",
          "value": 1000
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 19a(3)"
          }
        ]
      }
    ],
    "caution": "This is NOT a direct CSRD reporting duty and the cap is purpose-limited: it does not restrict requests made for due diligence, lending or other purposes (R-016). Do not infer purpose from the requestor's identity."
  },
  {
    "id": "CSRD-S-011",
    "version": 3,
    "ruleRef": "R-014",
    "title": "Above-cap request with decline right",
    "program": "CSRD",
    "decisionArea": "Value chain",
    "plainEnglish": "Where a protected undertaking receives a CSRD-purpose request containing items beyond the voluntary-standard cap, it may decline the above-cap items; the requestor must identify the excess and communicate the right to decline.",
    "scopeType": "request",
    "relationshipClass": "indirect_operational",
    "severity": "high",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "requirement_ref",
          "requirement": "CSRD-S-010",
          "expect": "APPLIES"
        },
        {
          "op": "count_cmp",
          "fact": "value_chain.items_above_cap",
          "cmp": "gt",
          "value": 0
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 19a(3)"
          }
        ]
      },
      {
        "sourceId": "SRC-008",
        "locators": [
          {
            "kind": "whole_document"
          }
        ]
      }
    ],
    "caution": "The cap protection does not extend to GHG emissions metrics — never advise declining emissions-data requests on cap grounds. The item catalogue versions against the voluntary-standard delegated act, which is adopted but not yet in force; mappings stay provisional until then."
  },
  {
    "id": "CSRD-S-012",
    "version": 3,
    "ruleRef": "R-018",
    "title": "Applicable ESRS version",
    "program": "CSRD",
    "decisionArea": "Standard selection",
    "plainEnglish": "The reporting undertaking must use the legally applicable ESRS version for its financial year. The 2023 ESRS (with the 2025 quick-fix) remain the baseline until the revised 2026 ESRS become legally effective.",
    "scopeType": "legal_entity",
    "relationshipClass": "standard_selection",
    "severity": "high",
    "kind": "selection",
    "cases": [
      {
        "when": {
          "op": "not",
          "of": {
            "op": "pack_flag",
            "flag": "revised_esrs_in_force"
          }
        },
        "value": "ESRS_2023",
        "label": "Revised act not yet in force — 2023 ESRS (incl. quick-fix) apply regardless of FY"
      },
      {
        "when": {
          "op": "fy_starts_on_or_after",
          "date": "2027-01-01"
        },
        "value": "ESRS_REVISED_2026",
        "label": "Revised ESRS mandatory for FY beginning on or after 1 Jan 2027"
      },
      {
        "when": {
          "op": "all",
          "of": [
            {
              "op": "fy_start_year_in",
              "years": [
                2026
              ]
            },
            {
              "op": "eq",
              "fact": "entity.early_adoption_revised_esrs",
              "value": true
            }
          ]
        },
        "value": "ESRS_REVISED_2026",
        "label": "FY2026 early adoption once the revised act is in force"
      }
    ],
    "defaultValue": "ESRS_2023",
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-005",
        "locators": [
          {
            "kind": "whole_document"
          }
        ]
      },
      {
        "sourceId": "SRC-007",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 2(1)(a)"
          },
          {
            "kind": "provision",
            "text": "Article 3"
          }
        ]
      }
    ],
    "caution": "The revised ESRS were adopted 3 Jul 2026 but were NOT in force at the pack snapshot; they must not alter current obligations until legal effectiveness (Change Watch CW-001)."
  },
  {
    "id": "CSRD-S-013",
    "version": 3,
    "ruleRef": "R-024",
    "title": "National-law completeness gate",
    "program": "CSRD",
    "decisionArea": "National overlay",
    "plainEnglish": "A final customer answer must identify the governing Member State and rest on its current transposition status, filing calendar, publication rules and exercised options. Until the country rules are encoded and ratified, no EU-level screen is a final legal conclusion.",
    "scopeType": "legal_entity",
    "relationshipClass": "legal_status_gate",
    "severity": "critical",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "in_catalogue",
          "fact": "entity.incorporation_country",
          "catalogue": "eu_member_states"
        },
        {
          "op": "exists",
          "fact": "entity.governing_member_state"
        },
        {
          "op": "in_catalogue",
          "fact": "entity.governing_member_state",
          "catalogue": "ratified_country_packs",
          "missReason": "national_law_unresolved"
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 53"
          }
        ]
      }
    ],
    "caution": "CSRD is directive-based law. A negative EU-level threshold result with this gate unresolved must read 'EU-level threshold not met; national-law status requires review' — never 'CSRD does not apply'."
  },
  {
    "id": "CSRD-S-014",
    "version": 3,
    "ruleRef": "R-017",
    "title": "Reporting duty (post-exemption)",
    "program": "CSRD",
    "decisionArea": "Reporting duty",
    "plainEnglish": "An active sustainability-reporting duty exists where the individual or consolidated threshold route applies and no transition, subsidiary or parent-report exemption removes it. Required information belongs in a clearly identifiable section of the (consolidated) management report.",
    "scopeType": "legal_entity",
    "relationshipClass": "direct_legal",
    "severity": "critical",
    "kind": "boolean",
    "condition": {
      "op": "all",
      "of": [
        {
          "op": "any",
          "of": [
            {
              "op": "requirement_ref",
              "requirement": "CSRD-S-001",
              "expect": "APPLIES"
            },
            {
              "op": "requirement_ref",
              "requirement": "CSRD-S-002",
              "expect": "APPLIES"
            }
          ]
        },
        {
          "op": "not",
          "of": {
            "op": "any",
            "of": [
              {
                "op": "requirement_ref",
                "requirement": "CSRD-S-004",
                "expect": "APPLIES"
              },
              {
                "op": "requirement_ref",
                "requirement": "CSRD-S-005",
                "expect": "APPLIES"
              },
              {
                "op": "requirement_ref",
                "requirement": "CSRD-S-006",
                "expect": "APPLIES"
              }
            ]
          }
        }
      ]
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 19a(1)"
          },
          {
            "kind": "provision",
            "text": "Article 29a(1)"
          }
        ]
      }
    ],
    "caution": "A standalone promotional sustainability report is not automatically sufficient. First reporting year and filing calendar resolve through the national overlay (S-013) and timing rules (R-005: generally FY beginning on or after 1 Jan 2027 for non-first-wave reporters)."
  },
  {
    "id": "CSRD-S-015",
    "version": 3,
    "ruleRef": "R-020",
    "title": "Limited assurance over sustainability reporting",
    "program": "CSRD",
    "decisionArea": "Assurance",
    "plainEnglish": "Statutory sustainability information is subject to limited assurance under the amended audit framework wherever the reporting duty is active.",
    "scopeType": "legal_entity",
    "relationshipClass": "direct_legal",
    "severity": "critical",
    "kind": "boolean",
    "condition": {
      "op": "requirement_ref",
      "requirement": "CSRD-S-014",
      "expect": "APPLIES"
    },
    "legalStatus": "in_force",
    "provenance": [
      {
        "sourceId": "SRC-001",
        "locators": [
          {
            "kind": "provision",
            "text": "Article 34(1)"
          }
        ]
      }
    ],
    "caution": "Provider eligibility and appointment rules require the national overlay. Limited assurance remains the mandatory level; the assurance standard is due by 1 July 2027."
  },
  {
    "id": "CSRD-S-016",
    "version": 3,
    "ruleRef": "R-023",
    "title": "First-three-years value-chain transition relief",
    "program": "CSRD",
    "decisionArea": "Transition disclosure",
    "plainEnglish": "During the first three reporting years, the undertaking may explain unavailable value-chain information and the efforts and plans to obtain it.",
